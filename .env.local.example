# .env.local — ローカル開発・デプロイ用（Git に含めない）
# コピーして .env.local を作成し、実際の値を入力してください。

# ── Supabase プロジェクト ─────────────────────────────────
SUPABASE_PROJECT_REF=your-project-ref          # supabase.com → Project Settings → General
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ── Vite (フロントエンド公開可能なキー) ─────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key           # Project Settings → API → anon public
VITE_APP_ENV=development

# ── Edge Function シークレット（サーバー側のみ）─────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Project Settings → API → service_role
ANTHROPIC_API_KEY=sk-ant-...                     # console.anthropic.com
STRIPE_SECRET_KEY=sk_live_...                    # dashboard.stripe.com → Developers → API keys
STRIPE_WEBHOOK_SECRET=whsec_...                  # Stripe → Webhooks → endpoint signing secret
STRIPE_PRICE_MONTHLY=price_...                   # Stripe → Products → 月額プランの Price ID
STRIPE_PRICE_ANNUAL=price_...                    # Stripe → Products → 年額プランの Price ID
