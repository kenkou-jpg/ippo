# ippo – Vite 環境変数テンプレート
#
# このファイルをコピーして .env.local を作成し、実際の値を記入してください。
# .env.local は .gitignore に含まれており、リポジトリにコミットされません。
#
# 本番: GitHub Secrets に各変数を登録する（ci.yml 参照）。
# ローカル開発: .env.local に記入した値が Vite により自動注入されます。

# Supabase
# Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase Dashboard → Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe（公開可能キーのみ。秘密キーはEdge Functionsの環境変数に設定）
# Stripe Dashboard → Developers → API keys → Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# App
VITE_APP_ENV=production

# Sentry（任意。未設定時はエラートラッキング無効・no-op）
# 設定方法・運用手順: docs/operations/SENTRY_SETUP.md 参照
VITE_SENTRY_DSN=
