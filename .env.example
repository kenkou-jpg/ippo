# ippo – Vite 環境変数テンプレート
#
# このファイルをコピーして .env.local を作成し、実際の値を記入してください。
# .env.local は .gitignore に含まれており、リポジトリにコミットされません。
#
# 本番: GitHub Secrets に VITE_SUPABASE_KEY を登録する（build.yml 参照）。
# ローカル開発: .env.local に記入した値が Vite により自動注入されます。

# Supabase anon key（公開キー）
# Supabase Dashboard → Settings → API → Project API keys → anon public
VITE_SUPABASE_KEY=your_supabase_anon_key_here
